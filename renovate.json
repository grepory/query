{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate-action/",
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Python upgrades require coordinated mise, UV_PYTHON, and project constraints.",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Keep the project Python constraint aligned with the manually managed runtime.",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    }
  ]
}
