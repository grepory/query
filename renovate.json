{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "branchPrefix": "renovate-action/",
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Python upgrades require coordinated mise, UV_PYTHON, and project constraints.",
      "matchManagers": ["mise"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
