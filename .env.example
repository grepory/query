# Copy to .env only when running the application or explicit evals.
# No database is contacted by the bootstrap or offline tests.
QUERY_DATABASE_URL=postgresql://localhost/query

# Explicit hosted eval: anthropic or openai. Set a model ID before running.
QUERY_MODEL_BACKEND=anthropic
QUERY_MODEL_NAME=
QUERY_ANTHROPIC_API_KEY=
QUERY_OPENAI_API_KEY=

# For a local OpenAI-compatible server, set backend=local and its loaded model ID.
QUERY_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
QUERY_LOCAL_API_KEY=local

# Reserved for acquisition work; not called during bootstrap.
QUERY_FIRECRAWL_API_KEY=
QUERY_EXA_API_KEY=
